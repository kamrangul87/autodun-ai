{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.autodun.com"
        }
      ],
      "destination": "https://autodun.com/:path*",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/cookie-policy",
      "destination": "/cookies",
      "permanent": true
    },
    {
      "source": "/about-ai",
      "destination": "https://ai.autodun.com",
      "permanent": true
    },
    {
      "source": "/used-car-insight",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/auto-parts-advisor",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ev-help-centre",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mot-predictor",
      "destination": "https://mot.autodun.com",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://www.googletagmanager.com; frame-src 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
